 void APIENTRY_GL4ES gl4es_glTexParameteri(GLenum target, GLenum pname, GLint param) {
+#if defined(__APPLE__) && !defined(GL4ES_NO_IOS_FASTPATH)
+    /* OSG re-applies the same filter/wrap state constantly.  Answer the
+     * redundant cases before entering the conversion + realization path. */
+    if(!glstate->list.pending && !glstate->list.active) {
+        const GLint itarget = what_target(target);
+        gltexture_t *texture = glstate->texture.bound[glstate->texture.active][itarget];
+        if(texture) {
+            switch(pname) {
+                case GL_TEXTURE_MIN_FILTER:
+                    if(texture->sampler.min_filter == (GLenum)param) { noerrorShim(); return; }
+                    break;
+                case GL_TEXTURE_MAG_FILTER:
+                    if(texture->sampler.mag_filter == (GLenum)param) { noerrorShim(); return; }
+                    break;
+                case GL_TEXTURE_WRAP_S:
+                    if(texture->sampler.wrap_s == (GLenum)param) { noerrorShim(); return; }
+                    break;
+                case GL_TEXTURE_WRAP_T:
+                    if(texture->sampler.wrap_t == (GLenum)param) { noerrorShim(); return; }
+                    break;
+            }
+        }
+    }
+#endif
     GLfloat fparam = param;
     gl4es_glTexParameterfv(target, pname, &fparam);
 }
