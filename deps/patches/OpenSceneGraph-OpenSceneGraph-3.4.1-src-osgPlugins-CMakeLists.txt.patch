--- a/OpenSceneGraph-OpenSceneGraph-3.4.1/src/osgPlugins/CMakeLists.txt
+++ b/OpenSceneGraph-OpenSceneGraph-3.4.1/src/osgPlugins/CMakeLists.txt
@@ -32,6 +32,25 @@
     osgUtil
 )
 
+# iOS build: only the image/reader plugins OpenMW actually uses.  Building all
+# optional plugins (IVE, OpenFlight, ...) is unnecessary and very slow.
+IF(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    ADD_SUBDIRECTORY(osg)
+    ADD_SUBDIRECTORY(bmp)
+    ADD_SUBDIRECTORY(dds)
+    ADD_SUBDIRECTORY(tga)
+    IF(JPEG_FOUND)
+        ADD_SUBDIRECTORY(jpeg)
+    ENDIF()
+    IF(PNG_FOUND)
+        ADD_SUBDIRECTORY(png)
+    ENDIF()
+    IF(FREETYPE_FOUND)
+        ADD_SUBDIRECTORY(freetype)
+    ENDIF()
+    RETURN()
+ENDIF()
+
