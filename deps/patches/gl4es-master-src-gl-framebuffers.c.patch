--- a/gl4es-master/src/gl/framebuffers.c
+++ b/gl4es-master/src/gl/framebuffers.c
@@ -256,6 +256,16 @@
     if(framebuffer==0)
         framebuffer = glstate->fbo.mainfbo_fbo;
 
+#if defined(__APPLE__) && !defined(GL4ES_NO_IOS_FASTPATH)
+    /* Re-binding the already current framebuffer is a GL no-op.  OSG does it
+     * around every render pass; skipping the driver call also skips the
+     * gles_glGetError() round-trip below. */
+    if(fb && glstate->fbo.current_fb == fb) {
+        noerrorShim();
+        return;
+    }
+#endif
+
     glstate->fbo.current_fb = fb;
         
     gles_glBindFramebuffer(target, framebuffer);
